<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculadora de Propinas"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <!-- Ardilla (vectorial) -->
    <ImageView
        android:id="@+id/ivArdilla"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ardilla"
        android:contentDescription="Ardilla"
        android:layout_marginBottom="24dp"
        app:tint="@color/purple_500"/>

    <!-- Botones -->
    <Button
        android:id="@+id/btnNuevoDia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo Día"
        android:backgroundTint="@color/purple_500"/>

    <Button
        android:id="@+id/btnVerRegistros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Registros"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnResumenSemanal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resumen Semanal"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnGestionarTrabajadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestionar Trabajadores"
        android:layout_marginTop="8dp"/>

    <!-- Espacio flexible -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Firma de agua -->
    <TextView
        android:id="@+id/tvFirma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="miraloqueyoobservo"
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="#888888"
        android:alpha="0.7"
        android:layout_marginBottom="8dp"/>

</LinearLayout>